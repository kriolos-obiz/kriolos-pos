<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.kriolos.opos</groupId>
        <artifactId>kriolos-opos-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>  
    <groupId>io.github.kriolos.opos</groupId>  
    <artifactId>kriolos-pos-doc</artifactId>
    <packaging>pom</packaging>
    <name>Kriolos.POS.Doc</name>
    <description>Kriolos :: POS official documentation</description>
    
    <properties>
        <asciidoc.source.directory>${basedir}/src/main/asciidoc</asciidoc.source.directory>
        <asciidoc.output.directory>${basedir}/target/generated-docs</asciidoc.output.directory>
        <asciidoc.images.directory>images</asciidoc.images.directory>

        <skipPdfGeneration>true</skipPdfGeneration>
        <antora-maven-plugin.version>1.0.0-alpha.5</antora-maven-plugin.version>
    </properties>
     
    <profiles>
        <profile>
            <id>antora</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.antora</groupId>
                        <artifactId>antora-maven-plugin</artifactId>
                        <version>${antora-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <playbookFile>${project.basedir}/antora-playbook.yml</playbookFile>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>antora</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>asciidoctor</id>
            <properties>
                <asciidoc.source.directory>${basedir}/modules</asciidoc.source.directory>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.itsallcode</groupId>
                        <artifactId>plantuml-maven-plugin</artifactId>
                        <version>1.0.0</version>
                        <configuration>
                            <sourceFiles>
                                <directory>${basedir}/src/main/plantuml</directory>
                                <includes>
                                    <include>**/*.puml</include>
                                </includes>
                            </sourceFiles>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>net.sourceforge.plantuml</groupId>
                                <artifactId>plantuml</artifactId>
                                <version>1.2026.6</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>render</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctor-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <configuration>
                            <relativeBaseDir>true</relativeBaseDir>
                            <outputDirectory>${asciidoc.output.directory}/pdf</outputDirectory>
                            <backend>pdf</backend>
                            <doctype>book</doctype>
                            <requires>
                                <require>asciidoctor-diagram</require>
                            </requires>
                            <attributes>
                                <icons>font</icons>
                                <pagenums />
                                <toc />
                                <idprefix />
                                <idseparator>-</idseparator>
                                
                                <project-version>${project.version}</project-version>
                                <properties-prefix>kriolos</properties-prefix>
                                <app-product-name>KriolOS POS</app-product-name>
                                <app-version>${project.version}</app-version>
                                <app-package-base-name>kriolos</app-package-base-name>
                                <source-highlighter>coderay</source-highlighter>
                                <pdf-stylesdir>${project.basedir}/src/themes</pdf-stylesdir>
                                <pdf-style>custom</pdf-style>
                            </attributes>
                        </configuration>

                        <executions>
                            <execution>
                                <id>pdf-guide-devel</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>process-asciidoc</goal>
                                </goals>
                                <configuration>
                                    <sourceDirectory>${basedir}/modules/guide-devel</sourceDirectory>
                                    <sourceDocumentName>guide-devel.adoc</sourceDocumentName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pdf-guide-user</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>process-asciidoc</goal>
                                </goals>
                                <configuration>
                                    <sourceDirectory>${basedir}/modules/guide-user</sourceDirectory>
                                    <sourceDocumentName>guide-user.adoc</sourceDocumentName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pdf-guide-comercial</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>process-asciidoc</goal>
                                </goals>
                                <configuration>
                                    <sourceDirectory>${basedir}/modules/guide-comercial</sourceDirectory>
                                    <sourceDocumentName>guide-comercial.adoc</sourceDocumentName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pdf-guide-migration</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>process-asciidoc</goal>
                                </goals>
                                <configuration>
                                    <sourceDirectory>${basedir}/modules/guide-migration</sourceDirectory>
                                    <sourceDocumentName>guide-migration.adoc</sourceDocumentName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pdf-notes</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>process-asciidoc</goal>
                                </goals>
                                <configuration>
                                    <sourceDirectory>${basedir}/modules/notes</sourceDirectory>
                                    <sourceDocumentName>notes.adoc</sourceDocumentName>
                                </configuration>
                            </execution>
                        </executions>
                        
                        <dependencies>
                            <dependency>
                                <groupId>org.asciidoctor</groupId>
                                <artifactId>asciidoctorj-pdf</artifactId>
                                <version>2.3.23</version>
                            </dependency>
                            <dependency>
                                <groupId>org.asciidoctor</groupId>
                                <artifactId>asciidoctorj-diagram</artifactId>
                                <version>3.2.1</version>
                            </dependency>
                            <dependency>
                                <groupId>org.asciidoctor</groupId>
                                <artifactId>asciidoctorj-diagram-plantuml</artifactId>
                                <version>1.2026.2</version>
                            </dependency>
                            <dependency>
                                <groupId>org.asciidoctor</groupId>
                                <artifactId>asciidoctorj-diagram-ditaamini</artifactId>
                                <version>1.0.3</version>
                            </dependency>
                            <dependency>
                                <groupId>org.asciidoctor</groupId>
                                <artifactId>asciidoctorj-chart</artifactId>
                                <version>1.0.0</version>
                            </dependency>
                            <dependency>
                                <groupId>org.asciidoctor</groupId>
                                <artifactId>asciidoctorj-epub3</artifactId>
                                <version>2.2.0</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>