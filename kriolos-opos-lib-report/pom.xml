<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.kriolos.opos</groupId>
        <artifactId>kriolos-opos-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>kriolos-opos-lib-report</artifactId>
    <packaging>jar</packaging>
    <name>Kriolos.POS.Lib.Report</name> 
    <properties>
        <exec.mainClass>KriolosOposLibReport</exec.mainClass>
        <jasperreports.version>7.0.7</jasperreports.version>
    </properties>
    
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>kriolos-opos-base</artifactId>
        </dependency>
        
        <!-- JASPER REPOR -->
        <dependency> 
            <groupId>net.sf.jasperreports</groupId>  
            <artifactId>jasperreports</artifactId>  
            <version>${jasperreports.version}</version> 
        </dependency>  
        <!-- DejaVu Sans, DejaVu Serif, and DejaVu Monospace fonts. -->
        <dependency> 
            <groupId>net.sf.jasperreports</groupId>  
            <artifactId>jasperreports-fonts</artifactId>  
            <version>${jasperreports.version}</version> 
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-charts</artifactId>
            <version>${jasperreports.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-jdt</artifactId>
            <version>${jasperreports.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-pdf</artifactId>
            <version>${jasperreports.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency> <!-- Used by JasperReport to generate xsl files -->
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.3</version>
            <scope>runtime</scope>
        </dependency>
       <!-- This extension automatically registers and aliases the free Liberation Sans font as Arial, Times New Roman, and Courier New--> 
        <dependency>
            <groupId>com.mpobjects.jasperreports.font</groupId>
            <artifactId>jasperreports-fonts-liberation</artifactId>
            <version>2.1.2</version>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.43</version>
        </dependency>
    </dependencies>
</project>